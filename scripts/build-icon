#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
RSVG=${RSVG:-$(command -v rsvg-convert)}
MASTER="$ROOT/.build/AppIcon-1024.png"
ICONSET="$ROOT/.build/AppIcon.iconset"
rm -rf "$ICONSET"
mkdir -p "$ICONSET" "$ROOT/.build"
"$RSVG" -w 1024 -h 1024 assets/AppIcon.svg -o "$MASTER"
resize() { sips -z "$1" "$1" "$MASTER" --out "$ICONSET/$2" >/dev/null; }
resize 16 icon_16x16.png
resize 32 icon_16x16@2x.png
resize 32 icon_32x32.png
resize 64 icon_32x32@2x.png
resize 128 icon_128x128.png
resize 256 icon_128x128@2x.png
resize 256 icon_256x256.png
resize 512 icon_256x256@2x.png
resize 512 icon_512x512.png
resize 1024 icon_512x512@2x.png
iconutil -c icns "$ICONSET" -o "$ROOT/Sources/TranscodePilot/Resources/AppIcon.icns"
printf '%s\n' "$ROOT/Sources/TranscodePilot/Resources/AppIcon.icns"
